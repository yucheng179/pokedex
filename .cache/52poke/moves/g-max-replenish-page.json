    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"zh-Hant\" dir=\"ltr\"><table class=\"bgl-一般 b-一般 roundy a-r at-c\" style=\"width:350px; margin-left:5px; margin-bottom:5px\">\n\n<tbody><tr>\n<th><span style=\"font-size:1.5em\">超極巨資源再生</span><br /><small><span lang=\"ja\">キョダイサイセイ</span> <span lang=\"en\">G-Max Replenish</span></small>\n</th></tr>\n<tr>\n<td class=\"roundy b-一般\" style=\"font-size:smaller;border-width:1px\">超極巨化卡比獸使出的一般屬性攻擊。會讓吃掉的樹果再生。\n</td></tr>\n<tr>\n<td class=\"at-c\"><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/wiki/File:%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif\" class=\"mw-file-description\"><img src=\"//s1.52poke.com/wiki/thumb/d/dc/%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif/350px-%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif\" decoding=\"async\" loading=\"lazy\" width=\"350\" height=\"197\" class=\"mw-file-element\" data-loginonly-srcset=\"//media.52poke.com/wiki/thumb/d/dc/%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif/525px-%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif 1.5x, //media.52poke.com/wiki/d/dc/%E8%B6%85%E6%9E%81%E5%B7%A8%E8%B5%84%E6%BA%90%E5%86%8D%E7%94%9F.gif 2x\" /></a><figcaption></figcaption></figure>\n</td></tr>\n<tr>\n<td>\n<table width=\"100%\" class=\"roundy b-一般\" style=\"background:#f0f0f0;border-width:1px\">\n\n<tbody><tr>\n<th colspan=\"2\" class=\"textblack\">對戰\n</th></tr>\n<tr class=\"textwhite bg-一般\">\n<th width=\"35%\" class=\"roundyleft\"><a href=\"/wiki/%E5%B1%9E%E6%80%A7\" title=\"屬性\">屬性</a>\n</th>\n<td class=\"roundyright at-l\">&#160;<a href=\"/wiki/%E4%B8%80%E8%88%AC%EF%BC%88%E5%B1%9E%E6%80%A7%EF%BC%89\" title=\"一般（屬性）\"><span class=\"sprite-type sprite-type-一般\"></span>&#160;一般</a>\n</td></tr>\n<tr class=\"bg-伽勒尔 ts-伽勒尔 textwhite\">\n<th class=\"roundyleft\"><a href=\"/wiki/%E4%BC%A4%E5%AE%B3#招式伤害计算公式\" title=\"傷害\">分類</a>\n</th>\n<td class=\"roundyright at-l\">&#160;<span class=\"mw-valign-middle\" typeof=\"mw:File\"><a href=\"/wiki/%E8%B6%85%E6%9E%81%E5%B7%A8%E6%8B%9B%E5%BC%8F\" title=\"超極巨招式\"><img src=\"//s1.52poke.com/wiki/thumb/6/68/%E6%9E%81%E5%B7%A8%E5%8C%96_icon.png/30px-%E6%9E%81%E5%B7%A8%E5%8C%96_icon.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"22\" class=\"mw-file-element\" data-loginonly-srcset=\"//media.52poke.com/wiki/thumb/6/68/%E6%9E%81%E5%B7%A8%E5%8C%96_icon.png/45px-%E6%9E%81%E5%B7%A8%E5%8C%96_icon.png 1.5x, //media.52poke.com/wiki/6/68/%E6%9E%81%E5%B7%A8%E5%8C%96_icon.png 2x\" /></a></span>&#160;<a href=\"/wiki/%E8%B6%85%E6%A5%B5%E5%B7%A8%E6%8B%9B%E5%BC%8F\" class=\"mw-redirect\" title=\"超極巨招式\">超極巨招式</a>\n</td></tr>\n<tr class=\"bgwhite\">\n<th class=\"roundytl\"><a href=\"/wiki/%EF%BC%B0%EF%BC%B0\" title=\"ＰＰ\">ＰＰ</a>\n</th>\n<td class=\"roundytr at-l\">&#160;— <small>（最大 —）</small>\n</td></tr>\n<tr class=\"bgwhite\">\n<th><a href=\"/wiki/%E5%A8%81%E5%8A%9B\" title=\"威力\">威力</a>\n</th>\n<td class=\"at-l\">&#160;—\n</td></tr>\n<tr class=\"bgwhite\">\n<th><a href=\"/wiki/%E5%91%BD%E4%B8%AD\" title=\"命中\">命中</a>\n</th>\n<td class=\"at-l\">&#160;—\n</td></tr>\n<tr class=\"bgwhite hide\">\n<th><a href=\"/wiki/%E4%BC%98%E5%85%88%E5%BA%A6\" title=\"優先度\">優先度</a>\n</th>\n<td class=\"at-l\">&#160;{{{priority}}}\n</td></tr>\n<tr>\n<td class=\"roundybottom bgwhite at-l\" style=\"font-size:0.90em\" colspan=\"2\"><div class=\"mw-collapsible mw-collapsed mw-customtoggle-moveBoxMore at-c\" id=\"mw-customcollapsible-moveBoxMore\"><b>收起</b></div>\n<div class=\"mw-collapsible mw-customtoggle-moveBoxMore at-c\" id=\"mw-customcollapsible-moveBoxMore\"><b>展開更多</b></div>\n<div class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-moveBoxMore\">\n<ul><li>不是接觸類招式</li>\n<li>不受守住影響</li>\n<li>不受魔法反射影響</li>\n<li>不受鸚鵡學舌影響</li></ul></div>\n</td></tr>\n<tr>\n<td class=\"textblack\" colspan=\"2\"><hr /><b><a href=\"/wiki/%E8%8C%83%E5%9B%B4\" title=\"範圍\">範圍</a></b>\n</td></tr>\n<tr>\n<td style=\"padding:5px\" colspan=\"2\">\n<table cellspacing=\"0\" style=\"background:transparent;\" class=\"at-c\" width=\"100%\">\n\n<tbody><tr>\n<td class=\"roundy-5\" style=\"background:#FFD3C4;border:1px solid#000\">對手\n</td>\n<th style=\"background:#;\">&#160;\n</th>\n<td class=\"roundy-5\" style=\"background:#FFD3C4;border:1px solid#000\">對手\n</td>\n<th class=\"hide\" style=\"background:#;\">&#160;\n</th>\n<td class=\"roundy-5 hide\" style=\"background:#C4EBFF;border:1px solid#000;\">對手\n</td></tr>\n<tr style=\"font-size:70%;\">\n<th style=\"background:#;display:inline\">&#160;&#160;&#160;&#160;&#160;\n</th>\n<th>\n</th>\n<th style=\"background:#;display:inline\">&#160;&#160;&#160;&#160;&#160;\n</th>\n<th class=\"hide\">\n</th>\n<th style=\"background:#;display:inline;display:none;\">&#160;&#160;&#160;&#160;&#160;\n</th></tr>\n<tr>\n<td class=\"roundy-5\" style=\"background:#C4EBFF;border:1px solid#000\">自身\n</td>\n<th style=\"background:#;\">&#160;\n</th>\n<td class=\"roundy-5\" style=\"background:#C4EBFF;border:1px solid#000\">同伴\n</td>\n<th class=\"hide\" style=\"background:#;\">&#160;\n</th>\n<td class=\"roundy-5 hide\" style=\"background:#C4EBFF;border:1px solid#000;\">同伴\n</td></tr></tbody></table>\n</td></tr>\n<tr>\n<td class=\"roundy-5 bgwhite\" colspan=\"2\"><a href=\"/wiki/Category:%E4%BD%9C%E7%94%A8%E8%8C%83%E5%9B%B4%E4%B8%BA%E4%BB%BB%E6%84%8F%E4%B8%80%E5%8F%AA%E5%AF%B9%E6%89%8B%E7%9A%84%E6%8B%9B%E5%BC%8F\" title=\"Category:作用範圍為任意一隻對手的招式\">任意一隻對手</a>\n</td></tr></tbody></table>\n</td></tr>\n<tr>\n<td>\n<table class=\"b-一般 roundy at-c bw-1 fulltable\" style=\"background:#f0f0f0;\">\n\n<tbody><tr>\n<td><b>出現遊戲</b>\n</td></tr>\n<tr>\n<td style=\"font-size:0.90em\"><div class=\"mw-collapsible mw-collapsed mw-customtoggle-moveBoxGame at-c\" id=\"mw-customcollapsible-moveBoxGame\"><b>收起</b></div>\n<div class=\"mw-collapsible mw-customtoggle-moveBoxGame at-c\" id=\"mw-customcollapsible-moveBoxGame\"><b>展開</b></div>\n</td></tr>\n<tr class=\"mw-collapsible mw-collapsed\" id=\"mw-customcollapsible-moveBoxGame\">\n<td>\n<table class=\"roundy at-c fulltable\">\n\n<tbody><tr>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 9%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 9%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 9%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 8%\">\n</td>\n<td style=\"width: 9%\">\n</td></tr>\n<tr class=\"hide\">\n<td class=\"bd-关都 bw-1 roundyleft bgwhite tl-关都\" colspan=\"4\">第一世代\n</td>\n<td class=\"bd-城都 bw-1 bgwhite tl-城都\" colspan=\"4\">第二世代\n</td>\n<td class=\"bd-丰缘 bw-1 roundyright bgl-丰缘 td-绿宝石\" colspan=\"4\">第三世代\n</td></tr>\n<tr class=\"hide\">\n<td class=\"bd-神奥 bw-1 roundyleft bgwhite tl-神奥\" colspan=\"6\">第四世代\n</td>\n<td class=\"bd-合众 bw-1 roundyright bgl-合众 td-合众\" colspan=\"6\">第五世代\n</td></tr>\n<tr class=\"hide\">\n<td class=\"bd-卡洛斯 bw-1 roundyleft bgl-X td-Y\" colspan=\"6\">Ｘ／Ｙ\n</td>\n<td class=\"bd-丰缘 bw-1 roundyright bgl-OR td-AS\" colspan=\"6\">Ω紅寶石／α藍寶石\n</td></tr>\n<tr class=\"hide\">\n<td class=\"bd-阿罗拉 bw-1 roundyleft bgl-太阳 td-月亮\" colspan=\"3\">太陽／月亮\n</td>\n<td class=\"bd-阿罗拉 bw-1 bgl-究极之日 td-究极之月\" colspan=\"3\">究日／究月\n</td>\n<td class=\"bd-关都 bw-1 bgwhite tl-关都\" colspan=\"3\">LG皮卡丘\n</td>\n<td class=\"bd-关都 bw-1 roundyright bgwhite tl-关都\" colspan=\"3\">LG伊布\n</td></tr>\n<tr class=\"\">\n<td class=\"bd-伽勒尔 bw-1 roundyleft bgl-剑 td-盾\" colspan=\"3\">劍／盾\n</td>\n<td class=\"bd-伽勒尔 bw-1 bgl-铠之孤岛 td-冠之雪原\" colspan=\"3\">擴充票\n</td>\n<td class=\"bd-神奥 bw-1 bgwhite tl-神奥\" colspan=\"3\">晶鑽／明珠\n</td>\n<td class=\"bd-洗翠 bw-1 roundyright bgwhite tl-洗翠\" colspan=\"3\">阿爾宙斯\n</td></tr>\n<tr class=\"hide\">\n<td class=\"bd-帕底亚 bw-1 roundyleft bgwhite tl-帕底亚\" colspan=\"3\">朱／紫\n</td>\n<td class=\"bd-帕底亚 bw-1 bgwhite tl-帕底亚\" colspan=\"3\">零之秘寶\n</td>\n<td class=\"bd-ZA bw-1 bgwhite tl-卡洛斯\" colspan=\"3\">Z-A\n</td>\n<td class=\"bd-ZA bw-1 roundyright bgwhite tl-卡洛斯\" colspan=\"3\">爆涌\n</td></tr>\n<tr>\n<td class=\"roundy bgwhite at-l\" colspan=\"12\" style=\"font-size: smaller;\">\n<ul><li>不是<a href=\"/wiki/%E6%8B%9B%E5%BC%8F%E5%AD%A6%E4%B9%A0%E5%99%A8\" title=\"招式學習器\">招式學習器</a>、<a href=\"/wiki/%E7%A7%98%E4%BC%A0%E5%AD%A6%E4%B9%A0%E5%99%A8\" title=\"秘傳學習器\">秘傳學習器</a>、<a href=\"/wiki/%E6%8B%9B%E5%BC%8F%E8%AE%B0%E5%BD%95\" title=\"招式紀錄\">招式紀錄</a>或<a href=\"/wiki/%E5%82%B3%E6%8E%88%E6%8B%9B%E5%BC%8F\" title=\"傳授招式\">傳授招式</a>。</li></ul>\n</td></tr></tbody></table>\n</td></tr></tbody></table>\n</td></tr>\n<tr class=\"hide\">\n<td class=\"at-l bgwhite b-一般 bw-1 roundy plainlinks\" style=\"font-size: smaller; padding-left: 8px;\">\n<ul><li>旁支系列遊戲中的<big><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F%EF%BC%88%E6%97%81%E6%94%AF%E7%B3%BB%E5%88%97%EF%BC%89&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"超極巨資源再生（旁支系列）（頁面不存在）\">超極巨資源再生</a></big></li></ul>\n</td></tr></tbody></table>\n<p><b>超極巨資源再生</b>（日文︰<b><span lang=\"ja\">キョダイサイセイ</span></b>，英文︰<b><span lang=\"en\">G-Max Replenish</span></b>）是<a href=\"/wiki/%E7%AC%AC%E5%85%AB%E4%B8%96%E4%BB%A3\" title=\"第八世代\">第八世代</a>引入的<a href=\"/wiki/%E4%B8%80%E8%88%AC%EF%BC%88%E5%B1%9E%E6%80%A7%EF%BC%89\" title=\"一般（屬性）\">一般屬性</a><a href=\"/wiki/%E8%B6%85%E6%A5%B5%E5%B7%A8%E6%8B%9B%E5%BC%8F\" class=\"mw-redirect\" title=\"超極巨招式\">超極巨招式</a>。這是<a href=\"/wiki/%E8%B6%85%E6%9E%81%E5%B7%A8%E5%8C%96\" class=\"mw-redirect\" title=\"超極巨化\">超極巨化</a><a href=\"/wiki/%E5%8D%A1%E6%AF%94%E5%85%BD\" title=\"卡比獸\">卡比獸</a>的專用超極巨招式。\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"zh-Hant\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">目次</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#招式附加效果\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">招式附加效果</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#招式说明\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">招式說明</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#可以学会该招式的宝可梦\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">可以學會該招式的寶可夢</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#动画中\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">動畫中</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#漫画中\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">漫畫中</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#招式动画\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">招式動畫</span></a></li>\n<li class=\"toclevel-1 tocsection-7\"><a href=\"#名字\"><span class=\"tocnumber\">7</span> <span class=\"toctext\">名字</span></a></li>\n</ul>\n</div>\n\n<h2><span id=\".E6.8B.9B.E5.BC.8F.E9.99.84.E5.8A.A0.E6.95.88.E6.9E.9C\"></span><span class=\"mw-headline\" id=\"招式附加效果\">招式附加效果</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=1\" title=\"編輯章節：招式附加效果\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=1\" title=\"編輯章節的原始碼： 招式附加效果\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>攻擊目標造成傷害。 \n</p><p>超極巨資源再生有50%機率獲得使用過的<a href=\"/wiki/%E6%A0%91%E6%9E%9C\" title=\"樹果\">樹果</a>（包括<a href=\"/wiki/%E6%8A%95%E6%8E%B7%EF%BC%88%E6%8B%9B%E5%BC%8F%EF%BC%89\" title=\"投擲（招式）\">投擲</a>）。在攻擊動畫中，樹上掉落了樹果時，表明樹果能再次使用。\n</p>\n<h2><span id=\".E6.8B.9B.E5.BC.8F.E8.AF.B4.E6.98.8E\"></span><span class=\"mw-headline\" id=\"招式说明\">招式說明</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=2\" title=\"編輯章節：招式說明\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=2\" title=\"編輯章節的原始碼： 招式說明\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h2><span id=\".E5.8F.AF.E4.BB.A5.E5.AD.A6.E4.BC.9A.E8.AF.A5.E6.8B.9B.E5.BC.8F.E7.9A.84.E5.AE.9D.E5.8F.AF.E6.A2.A6\"></span><span class=\"mw-headline\" id=\"可以学会该招式的宝可梦\">可以學會該招式的寶可夢</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=3\" title=\"編輯章節：可以學會該招式的寶可夢\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=3\" title=\"編輯章節的原始碼： 可以學會該招式的寶可夢\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>當<a href=\"/wiki/%E5%8D%A1%E6%AF%94%E5%85%BD\" title=\"卡比獸\">卡比獸</a>學會了能造成傷害的<a href=\"/wiki/%E4%B8%80%E8%88%AC%EF%BC%88%E5%B1%9E%E6%80%A7%EF%BC%89\" title=\"一般（屬性）\">一般屬性</a>招式，在進行超極巨化後便能使出超極巨資源再生。\n</p>\n<h2><span id=\".E5.8A.A8.E7.94.BB.E4.B8.AD\"></span><span class=\"mw-headline\" id=\"动画中\">動畫中</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=4\" title=\"編輯章節：動畫中\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=4\" title=\"編輯章節的原始碼： 動畫中\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h2><span id=\".E6.BC.AB.E7.94.BB.E4.B8.AD\"></span><span class=\"mw-headline\" id=\"漫画中\">漫畫中</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=5\" title=\"編輯章節：漫畫中\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=5\" title=\"編輯章節的原始碼： 漫畫中\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h2><span id=\".E6.8B.9B.E5.BC.8F.E5.8A.A8.E7.94.BB\"></span><span class=\"mw-headline\" id=\"招式动画\">招式動畫</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=6\" title=\"編輯章節：招式動畫\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;action=edit&amp;section=6\" title=\"編輯章節的原始碼： 招式動畫\"><span>編輯原始碼</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h2><span id=\".E5.90.8D.E5.AD.97\"></span><span class=\"mw-headline\" id=\"名字\">名字</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/index.php?title=%E8%B6%85%E6%A5%B5%E5%B7%A8%E8%B3%87%E6%BA%90%E5%86%8D%E7%94%9F&amp;veaction=edit&amp;section=7\" title=\"編輯章節：名字\" class=\"mw-editsection-visualeditor\"><span>編輯</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/index.php?title=%